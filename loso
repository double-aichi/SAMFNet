def compute_metrics(preds, labels):
    """计算 Acc、UF1、UAR"""
    preds = np.array([o.index(max(o)) for o in preds]) if isinstance(preds[0], list) else np.array(preds)
    labels = np.array(labels)
    acc = (preds == labels).mean() * 100.0
    uf1 = f1_score(labels, preds, average="macro") * 100.0
    uar = recall_score(labels, preds, average="macro") * 100.0
    return acc, uf1, uar

def init():

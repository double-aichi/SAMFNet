def loso_train():
    full_dataset, text_feats, subject_to_indices, subjects, device = init()

    results = {}
    for i, sub_val in enumerate(subjects, 1):
        print(f"\n{'='*60}")
        print(f"[LOSO 训练] Fold {i}/{len(subjects)} | 验证受试者: {sub_val}")
        print(f"{'='*60}")

        best_acc, best_f1 = trainer(
            sub_val=sub_val,
            full_dataset=full_dataset,
            text_feats=text_feats,
            subject_to_indices=subject_to_indices
        )
        results[sub_val] = {"acc": best_acc, "f1": best_f1}

        print(f"[Fold {sub_val} 完成]  Acc={best_acc:.2f}%  F1={best_f1:.2f}%")

    print(f"\n{'='*60}")
    print("所有 fold 训练完成！")
    print(f"模型保存在: {MODEL_SAVE_DIR}")
    print(f"{'='*60}")

    for sub_val, metrics in results.items():
        print(f"  {sub_val}: Acc={metrics['acc']:.2f}%  F1={metrics['f1']:.2f}%")



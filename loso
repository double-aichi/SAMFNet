def res(output, target, topk=(1,)):
    """Computes the results over the k top predictions for the specified values of k"""
    with torch.no_grad():
        output = torch.Tensor(output)
        target = torch.LongTensor(target)
        maxk = max(topk)
        batch_size = target.size(0)

        _, pred = output.topk(maxk, 1, True, True)
        pred = pred.t()
        correct = pred.eq(target.contiguous().view(1, -1).expand_as(pred))

        cor, acc, f1, uar = [], [], [], []
        for k in topk:
            cor_k = correct[:k].contiguous().view(-1).float().sum(0, keepdim=True)
            cor.append(cor_k.item())
            acc.append(cor_k.item()/batch_size*100)
            correct_k = correct[:k].sum(0)
            pred_k = torch.where(correct_k==0, pred[0], target)
            print(classification_report(target.numpy( ).tolist(), pred_k.numpy().tolist()))
            f1.append(f1_score(target.numpy().tolist(), pred_k.numpy().tolist(), average='macro'))
            uar.append(recall_score(target.numpy().tolist(), pred_k.numpy().tolist(), average='macro'))

            if k == 1:
                y_true = target.numpy()
                y_pred = pred_k.numpy()

                # 计算原始混淆矩阵
                cm = confusion_matrix(y_true, y_pred)

                # 计算归一化混淆矩阵（按行求和进行归一化）
                cm_normalized = cm.astype('float') / cm.sum(axis=1)[:, np.newaxis]
                mpl.rcParams['ytick.labelsize'] = 18
                # 设置科研绘图风格
                plt.figure(figsize=(7, 6), dpi=300)  # 高清 300 DPI
                sns.set_theme(style="white")
                mpl.rcParams['ytick.labelsize'] = 18

                labels = np.asarray([f"{val:.2f}" for val in cm_normalized.flatten()]).reshape(cm.shape)

                # 使用 Seaborn 绘制热力图
                ax = sns.heatmap(
                    cm_normalized,
                    annot=labels,  # 填充仅含类似 "0.81" 的标签
                    fmt="",  # 因为输入是字符串形式的labels，此处设为空
                    cmap="Blues",  # 经典学术蓝
                    linewidths=1.5,  # 网格线粗细
                    linecolor="#e2e8f0",
                    xticklabels=class_names,
                    yticklabels=class_names,
                    annot_kws={"size": 18, "weight": "bold"},  # 网格内数字加粗，大小适中
                    # cbar_kws={'label': 'Normalized Rate'}
                )

                # 美化坐标轴与标题
                # plt.title(f"Global LOSO Confusion Matrix ({dataset})", fontsize=13, pad=15, weight="bold")
                plt.ylabel("True label", fontsize=18, labelpad=8, weight="bold")
                plt.xlabel("Predict label", fontsize=18, labelpad=8, weight="bold")
                plt.xticks(rotation=45, ha='right', fontsize=18)
                plt.yticks(rotation=0, fontsize=18)

                # 调整布局防止标签文字被切掉
                plt.tight_layout()

                os.makedirs(PLOT_SAVE_DIR, exist_ok=True)
                save_path = os.path.join(PLOT_SAVE_DIR, f"confusion_matrix_{dataset}_{NUM_CLASSES}.png")

                plt.savefig(save_path, bbox_inches='tight', dpi=300)
                plt.close()
                print(f"\n[LOSO Evaluation] ✓ 精简版全局混淆矩阵已保存至:\n  {save_path}")
                # ====================================================

        return cor, acc, f1, uar

